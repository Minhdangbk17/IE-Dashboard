# =============================================================================
# .env.example — MES Dashboard
# Copy this file to .env and fill in real values. Never commit the real .env.
# =============================================================================

# --- Flask core (read by config.py) ---
# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key
# "development" enables Flask debug mode (auto-reload, interactive debugger).
# Use "production" when deployed.
FLASK_ENV=production
FLASK_DEBUG=0

# --- Database (currently SQLite — see note below) ---
# Path to the local SQLite file. Only meaningful when running with a writable,
# persistent filesystem (local dev, or a host that mounts a persistent volume).
DATABASE_PATH=data/mes_dashboard.db

# --- Excel Import ---
UPLOAD_FOLDER=uploads
# 1 = reject the whole file if any row is invalid. 0 = import valid rows, skip bad ones.
IMPORT_STRICT_MODE=0

# =============================================================================
# NOT YET USED BY THE APPLICATION — placeholders for a future Supabase/Postgres
# migration. Nothing in the codebase reads these yet (core/database.py talks to
# SQLite directly via the `sqlite3` module with `?` placeholders throughout every
# Engine's service.py). Wiring these in requires migrating the whole data-access
# layer, not just setting env vars. See the deploy checklist for details.
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
